# Copie ce fichier en ".env" puis renseigne tes valeurs.

# Numéro du bot (celui qui sera connecté), format international, chiffres uniquement.
# Exemple Congo-Brazzaville : 242061234567
NUMERO_BOT=

# Numéro du propriétaire (toi), même format. Plusieurs numéros : séparés par des virgules.
NUMERO_OWNER=

# Préfixe des commandes (ex : . ou ! ou /)
PREFIXE=.

# Ton nom de propriétaire (affiché dans le menu et le message de bienvenue)
NOM_OWNER=

# public = tout le monde peut utiliser le bot ; private = propriétaire uniquement
MODE=public


# Nombre maximum de numéros supplémentaires (commande .connecter)
# MAX_SESSIONS=3

# ---------------- CHATBOT (intelligence artificielle) ----------------
# Clés API gratuites. NE JAMAIS les partager. Laisse vide un service que tu n'utilises pas.
# Ordre de relais : Mistral -> Gemini -> Groq (si l'un atteint sa limite, le suivant prend le relais)
MISTRAL_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Réglages facultatifs (valeurs par défaut entre parenthèses)
# IA_ORDRE=mistral,gemini,groq
# IA_LIMITE_JOUR=30          (messages par personne et par jour, le propriétaire est illimité)
# IA_MEMOIRE_MSG=12          (nombre de messages gardés en contexte)
# IA_CONSERVATION_JOURS=30   (durée de conservation de l'historique)
# IA_PRIVE_DEFAUT=oui        (oui = le bot répond dès le premier message en privé ; non = il faut taper .chatbot on)

# ---------------- SERVICES FACULTATIFS (chaque clé est gratuite) ----------------
# Laisse vide ce que tu n'utilises pas. Ces valeurs ne se règlent QUE dans ce fichier, jamais par WhatsApp.
# .stickertelegram : jeton d'un bot Telegram créé avec @BotFather
# TELEGRAM_BOT_TOKEN=
# .chercherstickers : clé GIPHY (developers.giphy.com). Sur Kernel Connect elle est fournie par le site (PARTAGE_GIPHY_KEY)
# GIPHY_API_KEY=
# .identifier : jeton du service AudD (audd.io)
# AUDD_API_TOKEN=   (sur Kernel Connect elle est fournie par le site : PARTAGE_AUDD_TOKEN)
# Relève les limites de .github, .telechargergit et .verifiermaj
# GITHUB_TOKEN=   (sur Kernel Connect elle est fournie par le site : PARTAGE_GITHUB_TOKEN)
# Secret de chiffrement des clés personnelles (.macle). Sinon il est créé dans data/.macle_secret
# MACLE_SECRET=

# ---------------- OUTILS (chemins personnalisés, facultatif) ----------------
# YTDLP_PATH=
# FFMPEG_PATH=
# STICKER_PACK_NAME=
# STICKER_AUTHOR_NAME=

# ---------------- MISES À JOUR ----------------
# Dépôt GitHub (proprietaire/depot) où chercher la dernière « release », ou adresse d'un fichier JSON {"version":"1.2.0","url":"…"}
# MAJ_DEPOT=
# MAJ_URL=

# ---------------- CHAÎNE WHATSAPP & BIENVENUE ----------------
# Lien de la chaîne d'assistance (https://whatsapp.com/channel/...). Il est proposé dans le message de bienvenue et par .chaine
# CHAINE_URL=
# Message de bienvenue envoyé une seule fois à chaque numéro qui se connecte (oui / non)
# BIENVENUE=oui

# ---------------- HÉBERGEMENT À DISQUE ÉPHÉMÈRE (Render gratuit…) ----------------
# Garde la session WhatsApp dans Supabase au lieu du dossier « auth » (voir deploy/supabase.sql et le README).
# La clé « service_role » est SECRÈTE : à mettre seulement dans l'hébergeur ou ce fichier, jamais dans le code ni sur GitHub.
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_KEY=

# ---------------- KERNEL CONNECT (le site qui pilote ce bot) ----------------
# Secret partagé avec le site (même valeur dans Vercel : ENGINE_SECRET), 16 caractères minimum. Sans lui, l'API /engine reste fermée.
# Génère-le avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ENGINE_SECRET=

# --- MON PROPRE MOTEUR (chacun héberge son bot sur son Render, le site le pilote) ---
# Adresse du site Kernel Connect. Dès qu'elle est définie, le moteur passe en « mode site » :
# la session WhatsApp et l'état des instances sont gardés par le site, ce moteur ne détient AUCUNE clé de base de données.
# Sur le site : page « Mon moteur » → enregistre l'adresse de ce Render et copie le secret qu'elle te donne dans ENGINE_SECRET.
# SITE_URL=https://kernel-connect.vercel.app
# Adresse publique de ce moteur : automatique sur Render (RENDER_EXTERNAL_URL). À remplir seulement ailleurs.
# ENGINE_PUBLIC_URL=
# Nombre maximum de sessions supplémentaires (instances du site + numéros ajoutés). Sur Render gratuit : 2
# MAX_SESSIONS=2
# Service qui ne sert QUE de moteur pour le site (aucun bot principal, donc aucun code d'appairage dans les logs) : non
# PRINCIPAL=non
# Journal technique de la connexion WhatsApp (diagnostic) : error ou warn. Éteint par défaut.
# LOG_BAILEYS=

# Clé qui déchiffre les clés d'IA que les utilisateurs enregistrent sur le site (Paramètres > Mon IA). MÊME valeur que sur Vercel (ENGINES_KEY).
# Nécessaire seulement sur un moteur qui lit Supabase directement (instances de la plateforme). Un moteur en « mode site » n'en a pas besoin.
# Sans elle, les clés d'IA des utilisateurs ne sont pas lues : le bot utilise alors seulement celles de ce fichier.
# ENGINES_KEY=

# ---------------- DÉMARRAGE & ENVOIS (facultatif, valeurs par défaut entre parenthèses) ----------------
# Un numéro nouvellement lié reste en attente jusqu'à ce que son propriétaire tape .start. oui = il démarre tout de suite (non)
# DEMARRAGE_AUTO=non
# Renvoie le message « bot démarré » à chaque redémarrage du moteur, et pas seulement à la première liaison (non)
# MESSAGE_DEMARRAGE=non
# Secondes d'attente avant de connecter les numéros après un démarrage (15 sur Render, 0 ailleurs). Laisse le temps à l'ancienne version de s'éteindre.
# DELAI_DEMARRAGE_S=15
# Télécharge yt-dlp au démarrage (automatique sur Render ; oui pour le forcer ailleurs)
# YTDLP_AUTO=non
# Écart en millisecondes entre deux envois d'une même conversation (500)
# ENVOI_ECART_MS=500
# Ignore les commandes reçues depuis plus de N secondes (90) : évite de répondre à d'anciens messages après une coupure
# AGE_MAX_COMMANDE_S=90

# ---------------- COMMANDES ----------------
# Anciens noms de commandes (ceux de l'ancien bot) toujours reconnus. non = seuls les noms français actuels fonctionnent (oui)
# ANCIENS_NOMS=oui
# Numéros qui ont toutes les commandes réservées, en plus du créateur (séparés par des virgules, chiffres uniquement)
# NUMERO_ADMIN=
# Commandes ouvertes à tout le monde en plus de celles qui le sont déjà (noms séparés par des virgules). Les commandes protégées restent réservées.
# COMMANDES_OUVERTES=
# Pause en millisecondes entre deux lots de retraits de membres (commandes d'exclusion en masse) (1500)
# PAUSE_LOTS_MS=1500
# Pause en millisecondes entre deux personnes ajoutées par .reajouter (au hasard entre 6000 et 12000 : garde-la humaine pour ne pas risquer le numéro)
# REAJOUTER_PAUSE_MS=
